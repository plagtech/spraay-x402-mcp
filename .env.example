# No configuration is required. On first run the server auto-creates a wallet
# and persists it to ~/.spraay/.session, printing the address to fund (USDC on Base).
#
# Optional: provide your own wallet key instead of the auto-created one.
# EVM_PRIVATE_KEY=0xYourPrivateKeyHere

# Optional: Override gateway URL (default: https://gateway.spraay.app)
# SPRAAY_GATEWAY_URL=https://gateway.spraay.app
